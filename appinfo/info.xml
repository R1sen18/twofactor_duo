<?xml version="1.0"?>
<info xmlns:xsi= "http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>twofactor_duo</id>
	<name>Duo Universal Prompt</name>
	<summary>two-factor DUO</summary>
	<description>Two-factor authentication with the Duo Universal Prompt (Duo Web SDK v4). No Nextcloud core patches required.</description>
	<version>2.0.0</version>
	<licence>agpl</licence>
	<author>Muhammad Ardyansyah</author>
	<namespace>TwoFactorDuo</namespace>
	<category>integration</category>
	<category>security</category>
	
	<website>https://github.com/tilyanPristka/twofactor_duo#readme</website>
	<bugs>https://github.com/tilyanPristka/twofactor_duo/issues</bugs>
	<repository type="git">https://github.com/tilyanPristka/twofactor_duo.git</repository>
	
	<dependencies>
		<php min-version="8.1"/>
		<nextcloud min-version="32" max-version="35"/>
	</dependencies>
	<two-factor-providers>
		<provider>OCA\TwoFactorDuo\Provider\DuoProvider</provider>
	</two-factor-providers>
</info>
